diff --git a/ggml/src/ggml-metal/ggml-metal-device.h b/ggml/src/ggml-metal/ggml-metal-device.h
index 4012b9d..1f0abe6 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.h
+++ b/ggml/src/ggml-metal/ggml-metal-device.h
@@ -91,6 +91,14 @@ void ggml_metal_encoder_memory_barrier(ggml_metal_encoder_t encoder);
 
 void ggml_metal_encoder_end_encoding(ggml_metal_encoder_t encoder);
 
+// MoE bell: CPU work between two GPU stages inside one command buffer (MTLSharedEvent signal/wait, from moe-on-a-desk)
+// the CPU side runs from an MTLSharedEventListener notification instead of a spinning thread
+typedef void (*ggml_metal_moe_bell_fn)(void * ud, int il, const int32_t * ids, int64_t n_ids);
+void     ggml_metal_moe_bell_set(ggml_metal_moe_bell_fn fn, void * ud);
+bool     ggml_metal_moe_bell_enabled(void);
+uint64_t ggml_metal_moe_bell_post(int il, const int32_t * ids, int64_t n_ids); // the GPU signals v1 and waits for v1 + 1
+void     ggml_metal_moe_bell_encode(ggml_metal_cmd_buf_t cmd_buf, uint64_t v1);
+
 //
 // MTLLibrary wrapper
 //
diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
index 13aecbd..1647733 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -898,6 +898,115 @@ void ggml_metal_encoder_end_encoding(ggml_metal_encoder_t encoder) {
     [encoder->obj endEncoding];
 }
 
+static struct {
+    id<MTLSharedEvent>        ev;
+    MTLSharedEventListener *  listener;
+    ggml_metal_moe_bell_fn    fn;
+    void *                    ud;
+    uint64_t                  seq;
+} g_bell;
+
+void ggml_metal_moe_bell_set(ggml_metal_moe_bell_fn fn, void * ud) {
+    if (fn && !g_bell.ev) {
+        id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+        g_bell.ev = [dev newSharedEvent];
+        g_bell.ev.signaledValue = 0;
+        dispatch_queue_t q = dispatch_queue_create("ggml.metal.moe_bell", dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INTERACTIVE, 0));
+        g_bell.listener = [[MTLSharedEventListener alloc] initWithDispatchQueue:q];
+        g_bell.seq = 0;
+    }
+    g_bell.fn = fn;
+    g_bell.ud = ud;
+}
+
+bool ggml_metal_moe_bell_enabled(void) {
+    return g_bell.fn != NULL;
+}
+
+// GGML_METAL_BELL_SPIN=1: a worker thread spins on the event (as in moe-on-a-desk) instead of the listener
+#include <pthread.h>
+#define GGML_METAL_BELL_RING 8192
+static struct {
+    int  mode; // -1 unknown, 0 listener, 1 spin
+    pthread_mutex_t mtx;
+    pthread_cond_t  cv;
+    bool started;
+    struct { uint64_t v1; int il; const int32_t * ids; int64_t n; } ring[GGML_METAL_BELL_RING];
+    uint64_t head, tail;
+} g_spin = { .mode = -1, .mtx = PTHREAD_MUTEX_INITIALIZER, .cv = PTHREAD_COND_INITIALIZER };
+
+static void * ggml_metal_moe_bell_spin_worker(void * arg) {
+    (void) arg;
+    for (;;) {
+        pthread_mutex_lock(&g_spin.mtx);
+        while (g_spin.head == g_spin.tail) {
+            pthread_cond_wait(&g_spin.cv, &g_spin.mtx);
+        }
+        const uint64_t h = g_spin.head % GGML_METAL_BELL_RING;
+        const uint64_t v1 = g_spin.ring[h].v1;
+        const int il = g_spin.ring[h].il;
+        const int32_t * ids = g_spin.ring[h].ids;
+        const int64_t n = g_spin.ring[h].n;
+        pthread_mutex_unlock(&g_spin.mtx);
+
+        while (g_bell.ev.signaledValue < v1) {
+            // the GPU has not computed the routing of this lookup yet
+        }
+        if (g_bell.fn) {
+            g_bell.fn(g_bell.ud, il, ids, n);
+        }
+        g_bell.ev.signaledValue = v1 + 1;
+
+        pthread_mutex_lock(&g_spin.mtx);
+        g_spin.head++;
+        pthread_mutex_unlock(&g_spin.mtx);
+    }
+    return NULL;
+}
+
+uint64_t ggml_metal_moe_bell_post(int il, const int32_t * ids, int64_t n_ids) {
+    const uint64_t v1 = g_bell.seq + 1;
+    g_bell.seq += 2;
+    if (g_spin.mode < 0) {
+        const char * env = getenv("GGML_METAL_BELL_SPIN");
+        g_spin.mode = env != NULL && atoi(env) != 0;
+    }
+    if (g_spin.mode == 1) {
+        pthread_mutex_lock(&g_spin.mtx);
+        if (!g_spin.started) {
+            pthread_t th;
+            pthread_create(&th, NULL, ggml_metal_moe_bell_spin_worker, NULL);
+            g_spin.started = true;
+        }
+        GGML_ASSERT(g_spin.tail - g_spin.head < GGML_METAL_BELL_RING);
+        const uint64_t t = g_spin.tail % GGML_METAL_BELL_RING;
+        g_spin.ring[t].v1  = v1;
+        g_spin.ring[t].il  = il;
+        g_spin.ring[t].ids = ids;
+        g_spin.ring[t].n   = n_ids;
+        g_spin.tail++;
+        pthread_cond_signal(&g_spin.cv);
+        pthread_mutex_unlock(&g_spin.mtx);
+        return v1;
+    }
+    ggml_metal_moe_bell_fn fn = g_bell.fn;
+    void * ud = g_bell.ud;
+    [g_bell.ev notifyListener:g_bell.listener atValue:v1 block:^(id<MTLSharedEvent> ev, uint64_t value) {
+        (void) value;
+        if (fn) {
+            fn(ud, il, ids, n_ids);
+        }
+        ev.signaledValue = v1 + 1;
+    }];
+    return v1;
+}
+
+void ggml_metal_moe_bell_encode(ggml_metal_cmd_buf_t cmd_buf_raw, uint64_t v1) {
+    id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>) cmd_buf_raw;
+    [cmd_buf encodeSignalEvent:g_bell.ev value:v1];
+    [cmd_buf encodeWaitForEvent:g_bell.ev value:v1 + 1];
+}
+
 struct ggml_metal_device {
     id<MTLDevice> mtl_device;
 
