+#pragma once
+
+#include "ggml-backend.h"
+
+#include <memory>
+
+struct llama_model;
+
+// warms the page cache with the experts of host-resident (mmap) MoE layers right after the router selects them,
+// and predicts the experts of the next layer to read them while the current layer computes
+// enabled with LLAMA_MOE_PREFETCH=1 (pread), 2 (madvise WILLNEED) or 3 (touch the mapped pages); LLAMA_MOE_PREDICT=k reads the top k of the next layer
+class llama_moe_prefetch {
+public:
+    static std::unique_ptr<llama_moe_prefetch> create(const llama_model & model);
+    ~llama_moe_prefetch();
+
+    static bool eval_cb(ggml_tensor * t, bool ask, void * user_data);
+
+    struct impl;
+private:
+    explicit llama_moe_prefetch(std::unique_ptr<impl> p);
+    std::unique_ptr<impl> pimpl;
+};
