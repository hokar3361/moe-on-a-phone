+#if defined(__APPLE__)
+#include <dispatch/dispatch.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/param.h>
+#include <unistd.h>
+#endif
+
+#if defined(__APPLE__)
+
+namespace {
+
+struct read_chunk {
+    int             fd;
+    size_t          offs;
+    const uint8_t * addr; // same bytes in the mapping
+    size_t          size;
+};
+
+constexpr size_t page_size = 16384;
+constexpr size_t max_chunk = 512*1024;
+
+// how the chunks are brought into the page cache
+static void read_chunks(int mode, const read_chunk * chunks, size_t n, dispatch_queue_t q) {
+    if (n == 0) {
+        return;
+    }
+    struct ctx_t { int mode; const read_chunk * chunks; } ctx = { mode, chunks };
+    dispatch_apply_f(n, q, &ctx, [](void * p, size_t i) {
+        const ctx_t & c = *(const ctx_t *) p;
+        const read_chunk & r = c.chunks[i];
+        switch (c.mode) {
+            case 1: {
+                thread_local std::vector<uint8_t> buf(max_chunk);
+                size_t done = 0;
+                while (done < r.size) {
+                    const ssize_t k = pread(r.fd, buf.data(), r.size - done, (off_t) (r.offs + done));
+                    if (k <= 0) {
+                        break;
+                    }
+                    done += (size_t) k;
+                }
+            } break;
+            case 2: {
+                const uintptr_t a0 = (uintptr_t) r.addr & ~(uintptr_t) (page_size - 1);
+                const uintptr_t a1 = (uintptr_t) r.addr + r.size;
+                madvise((void *) a0, a1 - a0, MADV_WILLNEED);
+            } break;
+            default: {
+                volatile uint8_t sink = 0;
+                for (size_t o = 0; o < r.size; o += page_size) {
+                    sink ^= r.addr[o];
+                }
+                (void) sink;
+            } break;
+        }
+    });
+}
+
+}
+
+struct llama_moe_prefetch::impl {
+    struct part {
+        const ggml_tensor * w;
+        int    fd;
+        size_t offs;
+        size_t nb2;
+    };
+
+    const llama_model & model;
+    int mode;
+    int n_predict;
+    int n_expert;
+
+    std::vector<std::vector<part>> layers; // [n_layer] host expert tensors
+    std::vector<int> fds;                  // own descriptors, the model's may have F_NOCACHE set
+
+    dispatch_queue_t q_sync;
+    dispatch_queue_t q_pred;
+    dispatch_group_t g_pred;
+
+    int pred_layer = -1;
+    std::vector<int32_t> pred;
+    std::vector<read_chunk> chunks_pred;
+
+    std::vector<int32_t> ids;
+    std::vector<int32_t> uniq;
+    std::vector<uint8_t> is_pred;
+    std::vector<read_chunk> chunks;
+    std::vector<float> x;
+    std::vector<float> row;
+    std::vector<float> logits;
+    std::vector<int32_t> order;
+
+    // stats
+    size_t n_calls = 0;
+    size_t n_sel = 0;        // selected experts in layers that had a prediction
+    size_t n_hit = 0;        // of those, predicted
+    size_t bytes_sync = 0;
+    size_t bytes_pred = 0;
+    double t_sync_ms = 0.0;
+    double t_wait_ms = 0.0;
+    double t_route_ms = 0.0;
+
+    impl(const llama_model & model, int mode, int n_predict) : model(model), mode(mode), n_predict(n_predict) {
+        n_expert = (int) model.hparams.n_expert;
+        q_sync = dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0);
+        q_pred = dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0);
+        g_pred = dispatch_group_create();
+
+        std::vector<int> fd_map(1024, -1);
+        auto own_fd = [&](int fd) {
+            if (fd < 0 || fd >= (int) fd_map.size()) {
+                return -1;
+            }
+            if (fd_map[fd] < 0) {
+                char path[MAXPATHLEN];
+                if (fcntl(fd, F_GETPATH, path) == 0) {
+                    fd_map[fd] = open(path, O_RDONLY);
+                    if (fd_map[fd] >= 0) {
+                        fds.push_back(fd_map[fd]);
+                    }
+                }
+            }
+            return fd_map[fd];
+        };
+
+        layers.resize(model.layers.size());
+        for (size_t il = 0; il < model.layers.size(); ++il) {
+            const auto & layer = model.layers[il];
+            std::vector<part> parts;
+            bool ok = true;
+            for (const ggml_tensor * t : { layer.ffn_gate_up_exps, layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps }) {
+                if (t == nullptr) {
+                    continue;
+                }
+                const auto it = model.expert_files.find(t);
+                if (it == model.expert_files.end() || t->buffer == nullptr || !ggml_backend_buffer_is_host(t->buffer)) {
+                    ok = false;
+                    break;
+                }
+                parts.push_back({ t, own_fd(it->second.fd), it->second.offs, t->nb[2] });
+            }
+            if (ok && !parts.empty()) {
+                layers[il] = std::move(parts);
+            }
+        }
+        is_pred.assign(n_expert, 0);
+    }
+
+    ~impl() {
+        dispatch_group_wait(g_pred, DISPATCH_TIME_FOREVER);
+        for (int fd : fds) {
+            close(fd);
+        }
+        if (n_calls > 0) {
+            LLAMA_LOG_INFO("llama_moe_prefetch: mode %d, predict %d: %zu calls, sync %.1f ms (%.1f MiB), wait %.1f ms, route %.1f ms, predicted %.1f MiB, prediction hit %.1f%% (%zu/%zu)\n",
+                mode, n_predict, n_calls, t_sync_ms, bytes_sync/1048576.0, t_wait_ms, t_route_ms, bytes_pred/1048576.0,
+                n_sel ? 100.0*n_hit/n_sel : 0.0, n_hit, n_sel);
+        }
+    }
+
+    bool has_layer(int il) const {
+        return il >= 0 && il < (int) layers.size() && !layers[il].empty();
+    }
+
+    void add_chunks(std::vector<read_chunk> & out, int il, int32_t e, size_t & bytes) {
+        for (const part & p : layers[il]) {
+            const size_t offs = p.offs + (size_t) e*p.nb2;
+            const uint8_t * addr = (const uint8_t *) p.w->data + (size_t) e*p.nb2;
+            for (size_t o = 0; o < p.nb2; o += max_chunk) {
+                out.push_back({ p.fd, offs + o, addr + o, std::min(max_chunk, p.nb2 - o) });
+            }
+            bytes += p.nb2;
+        }
+    }
+
+    // the router input: walk from the selected experts back to the router matmul
+    static ggml_tensor * router_input(ggml_tensor * t) {
+        for (int i = 0; i < 16 && t != nullptr; ++i) {
+            if (t->op == GGML_OP_MUL_MAT) {
+                return t->src[1];
+            }
+            t = t->view_src != nullptr ? t->view_src : t->src[0];
+        }
+        return nullptr;
+    }
+
+    void predict(ggml_tensor * sel, int il_next) {
+        const auto t0 = std::chrono::steady_clock::now();
+
+        ggml_tensor * cur = router_input(sel);
+        const ggml_tensor * r = model.layers[il_next].ffn_gate_inp;
+        if (cur == nullptr || r == nullptr || cur->type != GGML_TYPE_F32 || r->ne[0] != cur->ne[0] || r->ne[1] != n_expert) {
+            return;
+        }
+        const int64_t n_embd = cur->ne[0];
+        x.resize(n_embd);
+        ggml_backend_tensor_get(cur, x.data(), (cur->ne[1] - 1)*cur->nb[1], n_embd*sizeof(float));
+
+        logits.resize(n_expert);
+        const bool host = r->buffer != nullptr && ggml_backend_buffer_is_host(r->buffer);
+        const auto * traits = ggml_get_type_traits(r->type);
+        row.resize(n_embd);
+        for (int e = 0; e < n_expert; ++e) {
+            const float * w;
+            if (host && r->type == GGML_TYPE_F32) {
+                w = (const float *) ((const uint8_t *) r->data + e*r->nb[1]);
+            } else if (host && traits->to_float != nullptr) {
+                traits->to_float((const uint8_t *) r->data + e*r->nb[1], row.data(), n_embd);
+                w = row.data();
+            } else {
+                return;
+            }
+            float s = 0.0f;
+            for (int64_t i = 0; i < n_embd; ++i) {
+                s += w[i]*x[i];
+            }
+            logits[e] = s;
+        }
+        order.resize(n_expert);
+        for (int e = 0; e < n_expert; ++e) {
+            order[e] = e;
+        }
+        const int k = std::min(n_predict, n_expert);
+        std::partial_sort(order.begin(), order.begin() + k, order.end(), [&](int a, int b) { return logits[a] > logits[b]; });
+        pred.assign(order.begin(), order.begin() + k);
+        pred_layer = il_next;
+
+        t_route_ms += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+
+        chunks_pred.clear();
+        for (int32_t e : pred) {
+            add_chunks(chunks_pred, il_next, e, bytes_pred);
+        }
+        struct job_t { impl * self; };
+        dispatch_group_async_f(g_pred, q_pred, this, [](void * p) {
+            impl * self = (impl *) p;
+            read_chunks(self->mode, self->chunks_pred.data(), self->chunks_pred.size(), self->q_pred);
+        });
+    }
+
+    void on_selected(ggml_tensor * sel, int il) {
+        const int64_t n_used   = sel->ne[0];
+        const int64_t n_tokens = sel->ne[1];
+        if (n_tokens > 4) {
+            return; // prompt batches touch most experts anyway
+        }
+        n_calls++;
+
+        ids.resize(n_used*n_tokens);
+        ggml_backend_tensor_get(sel, ids.data(), 0, ids.size()*sizeof(int32_t));
+
+        // the reads predicted for this layer must finish before they are counted on
+        const bool had_pred = pred_layer == il;
+        if (pred_layer >= 0) {
+            const auto t0 = std::chrono::steady_clock::now();
+            dispatch_group_wait(g_pred, DISPATCH_TIME_FOREVER);
+            t_wait_ms += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        }
+        if (had_pred) {
+            for (int32_t e : pred) {
+                is_pred[e] = 1;
+            }
+        }
+
+        const auto t0 = std::chrono::steady_clock::now();
+        uniq.clear();
+        for (int32_t e : ids) {
+            if (e >= 0 && e < n_expert && std::find(uniq.begin(), uniq.end(), e) == uniq.end()) {
+                uniq.push_back(e);
+            }
+        }
+        chunks.clear();
+        for (int32_t e : uniq) {
+            if (had_pred) {
+                n_sel++;
+                if (is_pred[e]) {
+                    n_hit++;
+                    continue;
+                }
+            }
+            add_chunks(chunks, il, e, bytes_sync);
+        }
+        if (had_pred) {
+            for (int32_t e : pred) {
+                is_pred[e] = 0;
+            }
+        }
+        pred_layer = -1;
+        read_chunks(mode, chunks.data(), chunks.size(), q_sync);
+        t_sync_ms += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+
+        if (n_predict > 0 && n_tokens == 1 && has_layer(il + 1)) {
+            predict(sel, il + 1);
+        }
+    }
+};
+
+std::unique_ptr<llama_moe_prefetch> llama_moe_prefetch::create(const llama_model & model) {
+    const char * env = getenv("LLAMA_MOE_PREFETCH");
+    const int mode = env != nullptr ? atoi(env) : 0;
+    if (mode <= 0 || model.expert_files.empty() || model.hparams.n_expert == 0) {
+        return nullptr;
+    }
+    const char * env_pred = getenv("LLAMA_MOE_PREDICT");
+    const int n_predict = env_pred != nullptr ? atoi(env_pred) : 0;
+    auto p = std::make_unique<impl>(model, mode, n_predict);
+    int n_layers = 0;
+    for (size_t il = 0; il < p->layers.size(); ++il) {
+        n_layers += p->has_layer((int) il);
+    }
+    if (n_layers == 0) {
+        return nullptr;
+    }
+    LLAMA_LOG_INFO("%s: mode %d, predict %d, %d host MoE layers\n", __func__, mode, n_predict, n_layers);
+    return std::unique_ptr<llama_moe_prefetch>(new llama_moe_prefetch(std::move(p)));
+}
+
+bool llama_moe_prefetch::eval_cb(ggml_tensor * t, bool ask, void * user_data) {
+    auto * self = (llama_moe_prefetch *) user_data;
+    int il = -1;
+    if (strncmp(t->name, "ffn_moe_topk-", 13) != 0 || sscanf(t->name + 13, "%d", &il) != 1 || !self->pimpl->has_layer(il)) {
+        return !ask; // not interested, keep computing
+    }
+    if (ask) {
+        return true;
+    }
+    self->pimpl->on_selected(t, il);
+    return true;
+}
+
+#else
+
+struct llama_moe_prefetch::impl {};
+
+std::unique_ptr<llama_moe_prefetch> llama_moe_prefetch::create(const llama_model &) {
+    return nullptr;
+}
+
+bool llama_moe_prefetch::eval_cb(ggml_tensor *, bool ask, void *) {
+    return !ask;
+}
+
+#endif
+
+llama_moe_prefetch::llama_moe_prefetch(std::unique_ptr<impl> p) : pimpl(std::move(p)) {}
+llama_moe_prefetch::~llama_moe_prefetch() = default;
