+// Wait for a command buffer by polling its status instead of blocking (from moe-on-a-desk 0007).
+// An idle CPU lets the SoC drop its fabric/memory clocks; a polling core keeps them up.
+// Off by default here (it costs power on a phone); GGML_METAL_SPIN_WAIT=1 turns it on.
+static void ggml_metal_wait_cmd_buf(id<MTLCommandBuffer> cmd_buf) {
+    static int spin = -1;
+    if (spin < 0) {
+        const char * env = getenv("GGML_METAL_SPIN_WAIT");
+        spin = env != NULL && atoi(env) != 0;
+    }
+    if (spin) {
+        while ([cmd_buf status] < MTLCommandBufferStatusCompleted) {
+            // busy poll
+        }
+    }
+    [cmd_buf waitUntilCompleted];
+}
+
 void ggml_metal_synchronize(ggml_metal_t ctx) {
     // wait for any backend operations to finish
     if (ctx->cmd_buf_last) {
-        [ctx->cmd_buf_last waitUntilCompleted];
+        ggml_metal_wait_cmd_buf(ctx->cmd_buf_last);
         ctx->cmd_buf_last = nil;
     }
 
